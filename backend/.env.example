# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager
# Long random string used to sign JWTs
JWT_SECRET=change-me
PORT=5000
# Optional: comma separated list of allowed frontend origins (all origins allowed when unset)
CLIENT_URL=http://localhost:3000
# Set to "production" in production so password-reset tokens are never returned by the API
NODE_ENV=development
